<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ARQ Valley School - Prefinal 1 Results</title>
  <style>
    body { font-family: Arial; background:#f4f6f8; }
    .box { width:600px; max-width:95%; margin:30px auto; background:#fff; padding:20px; border-radius:8px; }
    h2, h3 { text-align:center; }
    table { width:100%; border-collapse:collapse; margin-top:15px; }
    th, td { border:1px solid #333; padding:8px; text-align:center; }
    input, button { padding:8px; font-size:16px; width:90%; max-width:300px; margin:5px; }
    button { cursor:pointer; }
  </style>
</head>

<body>

<div class="box">
  <h2>ARQ VALLEY SCHOOL</h2>
  <h3>PREFINAL – 1 EXAMINATION RESULTS</h3>

  <center>
    <input type="text" id="roll" placeholder="Enter Roll No">
    <br>
    <button onclick="showResult()">View Result</button>
  </center>

  <div id="result"></div>
</div>

<script>
const students = [
 {roll:"2025101048", name:"SK GOUSIYA", gender:"F", marks:[87,98,95,81,72,67]},
 {roll:"2025101050", name:"SK BASHIRA", gender:"F", marks:[78,85,82,70,75,69]},
 {roll:"2025101051", name:"M SAI VENKATA HANU VINAY", gender:"M", marks:[88,79,84,90,86,80]},
 {roll:"2025101052", name:"T ANUSHA", gender:"F", marks:[92,88,91,85,89,90]},
 {roll:"2025101056", name:"K RAKESH", gender:"M", marks:[70,65,72,68,74,71]},
 {roll:"2025101057", name:"P PARDHU", gender:"M", marks:[83,76,80,78,82,79]},
 {roll:"2025101059", name:"P DHARSHAN VARDHAN", gender:"M", marks:[90,92,88,94,91,89]},
 {roll:"2025101061", name:"M RAJESWARI", gender:"F", marks:[86,84,83,80,82,85]},
 {roll:"2025101062", name:"O JOGANNA", gender:"M", marks:[60,58,62,55,61,59]},
 {roll:"2025101064", name:"P PRATHIMA", gender:"F", marks:[89,90,92,88,87,91]},
 {roll:"2025101065", name:"T YELLAJI", gender:"M", marks:[67,70,65,69,66,68]},
 {roll:"2025101067", name:"V UDAY KIRAN", gender:"M", marks:[85,83,87,82,84,86]},
 {roll:"2025101069", name:"K VINAY SATISH", gender:"M", marks:[91,89,90,88,92,93]},
 {roll:"2025101071", name:"M SIREESHA", gender:"F", marks:[88,86,85,87,84,89]}
];

function grade(total){
 if(total > 550) return "A+";
 if(total >= 500) return "A";
 if(total >= 400) return "B";
 if(total >= 300) return "C";
 if(total >= 211) return "D";
 return "FAIL";
}

function showResult(){
 let r = document.getElementById("roll").value;
 let s = students.find(x => x.roll === r);
 if(!s){ alert("Invalid Roll Number"); return; }

 let totals = students.map(x => x.marks.reduce((a,b)=>a+b,0)).sort((a,b)=>b-a);
 let total = s.marks.reduce((a,b)=>a+b,0);
 let rank = totals.indexOf(total) + 1;

 document.getElementById("result").innerHTML = `
 <p><b>ROLL NO:</b> ${s.roll}<br>
 <b>STUDENT NAME:</b> ${s.name}<br>
 <b>GENDER:</b> ${s.gender}</p>

 <table>
 <tr><th>SUBJECT</th><th>MARKS</th></tr>
 <tr><td>TELUGU</td><td>${s.marks[0]}</td></tr>
 <tr><td>HINDI</td><td>${s.marks[1]}</td></tr>
 <tr><td>ENGLISH</td><td>${s.marks[2]}</td></tr>
 <tr><td>MATHS</td><td>${s.marks[3]}</td></tr>
 <tr><td>SCIENCE</td><td>${s.marks[4]}</td></tr>
 <tr><td>SOCIAL</td><td>${s.marks[5]}</td></tr>
 </table>

 <p><b>TOTAL:</b> ${total}<br>
 <b>GRADE:</b> ${grade(total)}<br>
 <b>RANK:</b> ${rank}</p>
 `;
}
</script>

</body>
</html>
